{
  "name": "gatisdesign-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <=25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run verify:api && vite-react-ssg build && node scripts/verify-build.mjs",
    "build:csr": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "verify:api": "node scripts/verify-api-runtime.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "images:webp": "node scripts/convert-webp.mjs",
    "images:covers": "node scripts/smart-covers.mjs",
    "images:media": "node scripts/prepare-media.mjs"
  },
  "dependencies": {
    "@fontsource-variable/epilogue": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "clsx": "^2.1.1",
    "lenis": "^1.1.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.61.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vite-plugin-sitemap": "^0.7.1",
    "vite-react-ssg": "^0.9.1-beta.1",
    "vitest": "^2.1.9"
  }
}
