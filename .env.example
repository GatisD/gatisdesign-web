# Publiskais lapas URL - canonical, og:url, sitemap, JSON-LD.
VITE_SITE_URL=https://gatisdesign.com

# === Tikai serverim (Vercel Project Settings -> Environment Variables) ===
# Bez VITE_ prefiksa, citādi vērtība nonāktu pārlūkā.

# Resend API atslēga. Jauna atslēga: https://resend.com/api-keys
# Lokāli atslēga glabājas ~/.config/resend/gatis.env
# Obligāta - bez tās /api/contact atbild 500 ar kodu "config".
RESEND_API_KEY=

# Formas sūtītājs. Domēns send.gatisdesign.com ir verificēts Resend kontā un
# paredzēts formu plūsmām. gatisdesign.com konfigurāciju neaiztiekam - to
# lieto grāmatvedības platforma rēķiniem.
# Nav obligāts; noklusējums ir tieši šī vērtība.
CONTACT_FROM=Gatis Design <forma@send.gatisdesign.com>

# Kur nonāk pieteikums. Nav obligāts; noklusējums gatis.design@gmail.com.
CONTACT_TO=gatis.design@gmail.com

# Uz kurieni aiziet atbilde uz automātisko vēstuli. Nav obligāts;
# ja tukšs, tiek lietots CONTACT_TO.
CONTACT_REPLY_TO=

# Piezīme: reCAPTCHA netiek lietota. Formu sargā slēptais lauks (honeypot)
# un ātruma ierobežojums pēc IP api/contact.ts pusē.
