# Public site URL — used for canonical, og:url, sitemap, JSON-LD schema.
VITE_SITE_URL=https://gatisdesign.com

# Google reCAPTCHA v3 site key (public — safe to ship to client).
# TODO: pievienot kad būs reģistrēts: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=

# === Server-only secrets (Vercel Project Settings → Environment Variables) ===
# DO NOT prefix with VITE_ — they must stay server-only.
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Gatis Design <noreply@gatisdesign.com>
RESEND_TO_EMAIL=connect@gatisdesign.com
